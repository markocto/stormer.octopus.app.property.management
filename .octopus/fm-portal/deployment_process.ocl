step "deploy-fm-portal-to-iis" {
    name = "Deploy FM Portal to IIS"
    properties = {
        Octopus.Action.TargetRoles = "prop-man"
    }

    action "deploy-fm-portal-package" {
        action_type = "Octopus.TentaclePackage"
        name = "Deploy FM Portal package"
        properties = {
            Octopus.Action.EnabledFeatures = "Octopus.Features.IISWebSite,Octopus.Features.ConfigurationTransforms,Octopus.Features.ConfigurationVariables"
            Octopus.Action.IISWebSite.ApplicationPoolFrameworkVersion = "v4.0"
            Octopus.Action.IISWebSite.ApplicationPoolIdentityType = "ApplicationPoolIdentity"
            Octopus.Action.IISWebSite.ApplicationPoolName = "#{if Tenant.Name}#{Tenant.Name} - FM Portal Pool#{else}FM Portal - Shared Pool#{/if}"
            Octopus.Action.IISWebSite.Bindings = "[{\"protocol\":\"http\",\"port\":\"80\",\"host\":\"#{if Tenant.Hostname}#{Tenant.Hostname}#{else}localhost#{/if}\",\"thumbprint\":null,\"certificateVariable\":null,\"requireSni\":\"False\",\"enabled\":\"True\"}]"
            Octopus.Action.IISWebSite.CreateOrUpdateApplicationPool = "True"
            Octopus.Action.IISWebSite.CreateOrUpdateWebSite = "True"
            Octopus.Action.IISWebSite.EnableAnonymousAuthentication = "True"
            Octopus.Action.IISWebSite.EnableBasicAuthentication = "False"
            Octopus.Action.IISWebSite.EnableWindowsAuthentication = "False"
            Octopus.Action.IISWebSite.WebSiteName = "#{if Tenant.Name}#{Tenant.Name} - FM Portal#{else}FM Portal - Shared#{/if}"
            Octopus.Action.Package.AutomaticallyRunConfigurationTransformationFiles = "True"
            Octopus.Action.Package.AutomaticallyUpdateAppSettingsAndConnectionStrings = "True"
            Octopus.Action.Package.DownloadOnTentacle = "False"
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.PackageId = "FMPortal.Web"
            Octopus.Action.RunOnServer = "false"
        }

        packages {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "FMPortal.Web"
            properties = {
                Extract = "True"
                Purpose = ""
                SelectionMode = "immediate"
            }
        }
    }
}

step "run-database-migrations" {
    name = "Run Database Migrations"
    properties = {
        Octopus.Action.TargetRoles = "prop-man-db"
    }

    action "apply-tenant-database-migrations" {
        action_type = "Octopus.Script"
        name = "Apply tenant database migrations"
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                $connectionString = "#{Database.ConnectionString}"
                
                # 1. Run DbUp migrations against the shared demo database
                $exeDir = $OctopusParameters["Octopus.Action.Package[TridentDbUp].ExtractedPath"]
                $exePath = Join-Path $exeDir "Trident.Database.DbUp.exe"
                Write-Host "Running DbUp against SQLEXPRESS"
                $output = & $exePath --ConnectionString="$connectionString" 2>&1 | Out-String
                Write-Host $output
                if ($output -notmatch "Success!") {
                  throw "Database migration did not report success. Output: $output"
                }
                
                # 2. Wire the connection string through to the app pool so Trident.Web (in-process ANCM) can read it
                $poolName = "#{if Tenant.Name}#{Tenant.Name} - FM Portal Pool#{else}FM Portal - Shared Pool#{/if}"
                Write-Host "Setting TRIDENT_CONNECTION_STRING on app pool '$poolName'"
                Import-Module WebAdministration
                $existing = Get-WebConfigurationProperty -pspath 'MACHINE/WEBROOT/APPHOST' -filter "system.applicationHost/applicationPools/add[@name='$poolName']/environmentVariables" -name "." -ErrorAction SilentlyContinue
                if ($existing.Collection | Where-Object { $_.name -eq "TRIDENT_CONNECTION_STRING" }) {
                  Clear-WebConfiguration -pspath 'MACHINE/WEBROOT/APPHOST' -filter "system.applicationHost/applicationPools/add[@name='$poolName']/environmentVariables/add[@name='TRIDENT_CONNECTION_STRING']"
                }
                Add-WebConfigurationProperty -pspath 'MACHINE/WEBROOT/APPHOST' -filter "system.applicationHost/applicationPools/add[@name='$poolName']/environmentVariables" -name "." -value @{name='TRIDENT_CONNECTION_STRING';value=$connectionString}
                
                Write-Host "Stopping app pool '$poolName' to force a clean worker process restart"
                Stop-WebAppPool -Name $poolName
                Start-Sleep -Seconds 3
                Start-WebAppPool -Name $poolName
                Start-Sleep -Seconds 5
                Write-Host "App pool restarted"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
        }

        packages "TridentDbUp" {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "Trident.Database.DbUp"
            properties = {
                Extract = "True"
                Purpose = ""
                SelectionMode = "immediate"
            }
        }
    }
}

step "diagnose-iis-startup" {
    name = "Diagnose IIS Startup"
    properties = {
        Octopus.Action.TargetRoles = "prop-man-db"
    }

    action "enable-stdout-logging-and-capture-ancm-crash" {
        action_type = "Octopus.Script"
        name = "Enable stdout logging and capture ANCM crash"
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                Write-Host "----- Checking for ASP.NET Core Module registration -----"
                $modules = Get-WebGlobalModule | Where-Object { $_.Name -like "*AspNetCore*" }
                if ($modules) {
                  $modules | ForEach-Object { Write-Host "Found module: $($_.Name) -> $($_.Image)" }
                } else {
                  Write-Host "NO AspNetCore modules registered in IIS global modules list."
                }
                
                Write-Host "----- Checking installed .NET Hosting Bundle / runtimes -----"
                try {
                  $dotnetInfo = & dotnet --list-runtimes 2>&1 | Out-String
                  Write-Host $dotnetInfo
                } catch {
                  Write-Host "dotnet command not found or failed: $_"
                }
                
                Write-Host "----- Checking for hostfxr / ANCM native dll on disk -----"
                $candidatePaths = @(
                  "C:\Program Files\IIS\Asp.Net Core Module\V2\aspnetcorev2.dll",
                  "C:\Windows\System32\inetsrv\aspnetcorev2.dll"
                )
                foreach ($p in $candidatePaths) {
                  if (Test-Path $p) { Write-Host "EXISTS: $p" } else { Write-Host "MISSING: $p" }
                }
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
        }
    }
}

step "smoke-test" {
    name = "Smoke Test"
    properties = {
        Octopus.Action.TargetRoles = "prop-man"
    }

    action "verify-site-responds" {
        action_type = "Octopus.Script"
        name = "Verify site responds"
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                $hostname = "#{if Tenant.Name}#{Tenant.Hostname}#{else}localhost#{/if}"
                $url = "http://$hostname/"
                Write-Host "Checking $url"
                try {
                  $response = Invoke-WebRequest -Uri $url -UseBasicParsing -TimeoutSec 30
                  Write-Host "Site responded with status $($response.StatusCode)"
                } catch {
                  $errResponse = $_.Exception.Response
                  if ($errResponse) {
                    $status = [int]$errResponse.StatusCode
                    Write-Host "Site responded with status $status"
                    try {
                      $stream = $errResponse.GetResponseStream()
                      $reader = New-Object System.IO.StreamReader($stream)
                      $body = $reader.ReadToEnd()
                      $snippet = $body.Substring(0, [Math]::Min(4000, $body.Length))
                      Write-Host "----- RESPONSE BODY START -----"
                      Write-Host $snippet
                      Write-Host "----- RESPONSE BODY END -----"
                    } catch {
                      Write-Host "Could not read response body: $_"
                    }
                  } else {
                    Write-Warning "Request failed with no HTTP response: $_"
                  }
                }
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
        }
    }
}